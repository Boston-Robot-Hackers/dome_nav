<?xml version="1.0" ?>
<!--
  simple_room.world — Gazebo Harmonic SDF
  4x4 m enclosed room scaled for the dome2 robot (0.30 m diameter, 0.15 m tall).
  Interior dividing wall with a 0.6 m doorway.
  Robot is spawned separately via ros_gz_sim + dome3_sim.urdf.
  No external model URIs required.
-->
<sdf version="1.8">
  <world name="simple_room">

    <!-- 1ms steps meant ~1000 /clock messages/sec in theory (measured 350-470Hz under
         load) that every use_sim_time node in the stack has to process, independent of
         their own work — a real, measured CPU cost (see TF13 T04 notes). 10ms is still
         fine-grained for a simple diff-drive robot and cuts that message rate ~10x. -->
    <physics name="10ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"          name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.4 0.6 0.3 1</ambient>
            <diffuse>0.4 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Room: 4x4 m interior (x: -2..+2, y: -2..+2).
      Walls: 0.1 m thick, 0.4 m tall (well above robot laser at ~0.15 m).
      Robot (0.30 m dia) spawns at (-1, -1) — comfortably clear of all walls.
    -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 2.05 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.2 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.2 0.1 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -2.05 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.2 0.1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.2 0.1 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-2.05 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 4.0 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>2.05 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 4.0 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 0.4</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      Interior dividing wall along x=0 (north-south).
      Doorway: y=-0.3 to y=+0.3 (0.6 m gap — 2x robot diameter).
      South segment: y=-2 to y=-0.3, centre y=-1.15, length=1.7 m.
      North segment: y=+0.3 to y=+2,  centre y=+1.15, length=1.7 m.
    -->
    <model name="interior_wall_south">
      <static>true</static>
      <pose>0 -1.15 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 1.7 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.7 0.4</size></box></geometry>
          <material><ambient>0.6 0.6 0.8 1</ambient><diffuse>0.6 0.6 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="interior_wall_north">
      <static>true</static>
      <pose>0 1.15 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 1.7 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.7 0.4</size></box></geometry>
          <material><ambient>0.6 0.6 0.8 1</ambient><diffuse>0.6 0.6 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
